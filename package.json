{
  "name": "background-video-renderer",
  "version": "1.0.0",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 dist-electron/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:mac": "bash platforms/mac/package.sh"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/do-hyeon": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "@fontsource/kosugi-maru": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/nanum-gothic": "^5.3.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@fontsource/noto-serif-kr": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/sawarabi-mincho": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.local.background-video-renderer",
    "productName": "Background Video Renderer",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/@ffprobe-installer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video",
      "icon": "platforms/mac/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "platforms/mac/entitlements.mac.plist",
      "entitlementsInherit": "platforms/mac/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "platforms/mac/icon.png"
    }
  }
}
